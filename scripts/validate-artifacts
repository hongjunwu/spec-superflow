#!/usr/bin/env node
// validate-artifacts - Validate spec-superflow artifacts
// Usage: node scripts/validate-artifacts [change-dir]
//
// Reads one change directory (default: every bundled example) and validates all
// artifacts found:
//   - proposal.md (change content validation)
//   - specs/*/spec.md (delta spec validation)
//   - technical-design.md + traceability.json (when the Engineering Profile
//     declares brownfield, or a standard change carries the optional design)

import { readFileSync, readdirSync, existsSync, statSync } from 'fs';
import { join, basename } from 'path';
import { Validator } from '../dist/index.js';
import { validateSpecPathLayout, relativeSpecPath } from './lib/spec-paths.mjs';
import { formatTechnicalMapping, validateTechnicalChange } from './lib/technical-validation.mjs';

function printReport(label, report) {
  console.log(`\n  📋 ${label}`);
  if (report.valid) {
    console.log(`     ✅ valid (${report.summary.errors} errors, ${report.summary.warnings} warnings, ${report.summary.info} info)`);
  } else {
    console.log(`     ❌ invalid (${report.summary.errors} errors, ${report.summary.warnings} warnings, ${report.summary.info} info)`);
  }
  for (const issue of report.issues) {
    const icon = issue.level === 'ERROR' ? '🔴' : issue.level === 'WARNING' ? '🟡' : '🔵';
    const lineInfo = issue.line ? `:${issue.line}` : '';
    console.log(`     ${icon} [${issue.level}] ${issue.path}${lineInfo}: ${issue.message}`);
  }
}

function validateChangeDir(changeDir, validator) {
  const changeName = basename(changeDir);

  console.log(`🔍 Validating artifacts in: ${changeDir}`);
  console.log(`   Change: ${changeName}`);

  let hasErrors = false;

  const proposalPath = join(changeDir, 'proposal.md');
  if (existsSync(proposalPath)) {
    try {
      const content = readFileSync(proposalPath, 'utf-8');
      const report = validator.validateChangeContent(changeName, content);
      printReport('proposal.md (change content)', report);
      if (!report.valid) hasErrors = true;
    } catch (e) {
      console.log(`\n  📋 proposal.md`);
      console.log(`     ❌ Error reading file: ${e instanceof Error ? e.message : 'Unknown error'}`);
      hasErrors = true;
    }
  } else {
    console.log(`\n  ⚠️  proposal.md not found`);
  }

  const specLayout = validateSpecPathLayout(changeDir, { requireSpecs: true });
  for (const failure of specLayout.failures) {
    console.log(`\n  ❌ ${failure}`);
    hasErrors = true;
  }

  for (const specFile of specLayout.specFiles) {
    try {
      const content = readFileSync(specFile, 'utf-8');
      const report = validator.validateDeltaSpec(content);
      const relative = relativeSpecPath(changeDir, specFile);
      printReport(`${relative} (delta spec)`, report);
      if (!report.valid) hasErrors = true;
    } catch (e) {
      const relative = relativeSpecPath(changeDir, specFile);
      console.log(`\n  📋 ${relative}`);
      console.log(`     ❌ Error reading file: ${e instanceof Error ? e.message : 'Unknown error'}`);
      hasErrors = true;
    }
  }

  const technicalReport = validateTechnicalChange(changeDir);
  if (technicalReport.applies || technicalReport.issues.length > 0) {
    printReport('technical validation', technicalReport);
    if (!technicalReport.valid) hasErrors = true;
    if (technicalReport.valid && technicalReport.applies) {
      for (const line of formatTechnicalMapping(technicalReport.traceability)) console.log(`     ↳ ${line}`);
    }
  }

  return hasErrors;
}

// Every bundled example is validated by default so the technical gate covers
// the brownfield example as well as the standard ones.
function defaultChangeDirs() {
  const examplesRoot = 'docs/examples';
  return readdirSync(examplesRoot)
    .sort()
    .map(name => join(examplesRoot, name))
    .filter(dir => existsSync(join(dir, 'proposal.md')));
}

function main() {
  const args = process.argv.slice(2);
  const changeDirs = args[0] ? [args[0]] : defaultChangeDirs();
  for (const changeDir of changeDirs) {
    if (!existsSync(changeDir) || !statSync(changeDir).isDirectory()) {
      console.error(`Error: "${changeDir}" is not a valid directory`);
      process.exit(2);
    }
  }

  const validator = new Validator(false);
  let failed = false;
  for (const changeDir of changeDirs) {
    if (validateChangeDir(changeDir, validator)) failed = true;
  }

  console.log('');
  if (failed) {
    console.log('❌ Validation failed with errors.');
    process.exit(1);
  } else {
    console.log('✅ All artifacts validated successfully.');
    process.exit(0);
  }
}

main();
